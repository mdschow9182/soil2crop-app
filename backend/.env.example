# Local development only. Production must set these values in the cloud host.
NODE_ENV=development
PORT=5001
USE_MEMORY_DB=true

# Set USE_MEMORY_DB=false and use a persistent MongoDB Atlas URI for production.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/soil2crop?retryWrites=true&w=majority

# Optional DNS resolver override for MongoDB Atlas SRV/TXT resolution.
# Leave unset on cloud hosts unless their network resolver requires an override.
# MONGODB_DNS_SERVERS=<resolver-ip-1>,<resolver-ip-2>

# Backend-only secret; generate a random value with at least 32 characters.
JWT_SECRET=<generate-a-random-secret-at-least-32-characters>
OPENWEATHER_API_KEY=<optional-weather-provider-key>

# Comma-separated exact HTTPS web origins, if a browser frontend is hosted.
# Capacitor localhost origins are allowed explicitly by the API.
CORS_ORIGINS=https://<your-web-frontend-host>
