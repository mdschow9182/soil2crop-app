{
  "name": "soil2crop",
  "version": "1.0.0",
  "description": "Soil2Crop - Agricultural Advisory Platform with IoT Integration",
  "private": true,
  "scripts": {
    "start": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && npm run dev",
    "frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "setup": "cd backend && npm install && cd ../frontend && npm install",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "test": "node scripts/run-test-report.js",
    "test:backend": "npm --prefix backend test -- --runInBand",
    "test:frontend": "npm --prefix frontend test -- --run",
    "test:e2e": "playwright test",
    "test:report": "node scripts/run-test-report.js"
  },
  "keywords": [
    "agriculture",
    "iot",
    "crop-recommendation",
    "soil-analysis",
    "farming",
    "machine-learning"
  ],
  "author": "Soil2Crop Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "mongodb-memory-server": "^11.3.0",
    "multer": "^2.1.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
