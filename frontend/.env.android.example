# Copy this file to .env.android.local for an Android-on-Wi-Fi build.
# Replace YOUR-PC-LAN-IP with the current computer's IPv4 from `ipconfig`.
# The Android build uses `npm run build:android`; the normal browser build
# continues using .env/.env.local and localhost. Do not commit a personal IP.
VITE_API_URL=http://YOUR-PC-LAN-IP:5001
