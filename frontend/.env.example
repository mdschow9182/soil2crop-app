# Browser development backend. Keep this as localhost for PC browser work.
VITE_API_URL=http://localhost:5001

# For Android LAN testing, copy .env.android.example to the ignored
# .env.android.local and replace its placeholder with the PC IPv4 from ipconfig.

# Production builds require an HTTPS API URL, for example:
# VITE_API_URL=https://api.example.com
